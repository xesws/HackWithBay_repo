{
  "pipeline": {
    "description": "GraphJudge verification pipeline (Track B, Shape 2). webhook {user_id, job_id, text, bearer} -> graphjudge_runner -> response_text. graphjudge_runner performs the production steps in order: consume_credit -> OpenRouter extract_claims -> POST {SCORER_URL}/score -> best-effort persist. Emits contracts.md §4.2 verdict JSON on the text lane. RocketRide self-hosted runtime (decisions #0, Cloud waived).",
    "version": 1,
    "project_id": "0aa9cefd-2f2c-46f4-a870-3dcc2db61f2f",
    "source": "webhook_in",
    "components": [
      {
        "id": "webhook_in",
        "provider": "webhook",
        "name": "verify webhook (§4.4)",
        "description": "Product-facing entry. Body {user_id, job_id?, text}. job_id is uuid4 (contracts v1.1, decisions #1); generated by scorer/verify.py when absent before data reaches this pipeline.",
        "config": { "type": "webhook", "hideForm": true, "mode": "Source", "parameters": {} }
      },
      {
        "id": "graphjudge_runner",
        "provider": "graphjudge_runner",
        "name": "graphjudge_runner (§4.5 -> §4.1 -> §4.2)",
        "description": "Custom RocketRide text filter. Input is the §4.4 JSON body encoded as text/plain. It emits SSE step logs and returns the §4.2 verdict JSON string on lane 'text'.",
        "config": { "type": "graphjudge_runner" },
        "input": [{ "from": "webhook_in", "lane": "text" }]
      },
      {
        "id": "respond",
        "provider": "response_text",
        "name": "respond (§4.2 text passthrough)",
        "description": "Returns graphjudge_runner's verdict JSON string under the response_text lane key.",
        "config": { "laneName": "text" },
        "input": [{ "from": "graphjudge_runner", "lane": "text" }]
      }
    ]
  }
}
