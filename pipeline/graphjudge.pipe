{
  "pipeline": {
    "description": "GraphJudge verification pipeline (Track B, Shape 2). webhook {user_id, job_id?, text} -> credit_gate -> extract_claims -> score -> respond+persist. Emits contracts.md §4.2 verdict. RocketRide self-hosted runtime (decisions #0, Cloud waived).",
    "version": 1,
    "project_id": "REPLACE_WITH_PROJECT_GUID",
    "source": "webhook_in",
    "components": [
      {
        "id": "webhook_in",
        "provider": "webhook",
        "name": "verify webhook (§4.4)",
        "description": "Product-facing entry. Body {user_id, job_id?, text}. job_id is uuid4 (contracts v1.1, decisions #1); generated by scorer/verify.py when absent before data reaches this pipeline.",
        "config": {
          "path": "/verify",
          "method": "POST",
          "content_type": "application/json",
          "expects": { "user_id": "string", "job_id": "string(uuid4, optional)", "text": "string" }
        }
      },
      {
        "id": "credit_gate",
        "provider": "python",
        "name": "credit_gate (§4.5 consume_credit)",
        "description": "Single-transaction debit via Track C consume_credit. balance>0 -> emit on lane 'ok'; else short-circuit on lane 'denied' with {\"error\":\"insufficient_credits\",\"balance\":0}.",
        "config": {
          "entry": "pipeline.credits:consume_credit",
          "args": { "user_id": "$.user_id", "job_id": "$.job_id" },
          "env": ["CONSUME_CREDIT_URL", "BUTTERBASE_API_KEY"],
          "routes": {
            "ok": { "when": "result.ok == true", "emit": "$" },
            "denied": { "when": "result.ok == false", "emit": { "error": "insufficient_credits", "balance": "$result.balance" } }
          },
          "_note": "Offline (no CONSUME_CREDIT_URL) the helper returns a stub {ok,balance} so the chain runs with no backend."
        },
        "input": [{ "from": "webhook_in", "lane": "output" }]
      },
      {
        "id": "extract_claims",
        "provider": "python",
        "name": "extract_claims (§4.1)",
        "description": "prose text -> §4.1 claims JSON. DEFAULT = deterministic offline regex extractor (no LLM key). LLM upgrade = OpenRouter (z-ai/glm-5.2) via pipeline.llm, keyed by OPENROUTER_API_KEY.",
        "config": {
          "entry": "pipeline.extract_claims:extract_claims",
          "args": { "job_id": "$.job_id", "text": "$.text", "validate": true },
          "model": "auto",
          "env": ["OPENROUTER_API_KEY"],
          "_note": "model=auto -> OpenRouter z-ai/glm-5.2 when OPENROUTER_API_KEY is set, else the offline regex extractor, so the pipeline works with NO key. All LLM calls go through OpenRouter (never Anthropic/OpenAI)."
        },
        "input": [{ "from": "credit_gate", "lane": "ok" }]
      },
      {
        "id": "score",
        "provider": "python",
        "name": "score (§4.2)",
        "description": "§4.1 claims -> §4.2 verdict via Track A scoring. In-process reuse of scorer.scoring:score_job over the CSV reference graph; HTTP alt POST {SCORER_URL}/score when SCORER_URL is set.",
        "config": {
          "entry": "scorer.scoring:score_job",
          "reference": "scorer.app:get_reference",
          "args": { "job_id": "$.job_id", "claims": "$.claims" },
          "env": ["SCORER_URL", "SCORER_REFERENCE_BACKEND"],
          "_note": "score_job(ScoreRequest, reference) returns a ScoreResponse; serialize with .model_dump() to the §4.2 dict."
        },
        "input": [{ "from": "extract_claims", "lane": "output" }]
      },
      {
        "id": "persist",
        "provider": "python",
        "name": "persist (§4.5 results/jobs)",
        "description": "Best-effort upsert jobs + insert results(job_id,user_id,verdict_json) on the live Butterbase schema. Passes the verdict through unchanged on lane 'output'.",
        "config": {
          "entry": "pipeline.credits:persist_result",
          "args": { "job_id": "$.job_id", "user_id": "$user_id", "verdict": "$" },
          "passthrough": "$",
          "env": ["PERSIST_RESULT_URL", "BUTTERBASE_API_KEY"],
          "_note": "Offline (no PERSIST_RESULT_URL) this is a logged no-op; persistence never gates the response."
        },
        "input": [{ "from": "score", "lane": "output" }]
      },
      {
        "id": "respond",
        "provider": "response",
        "name": "respond (§4.2 passthrough)",
        "description": "Returns the §4.2 verdict verbatim on the happy path, or the credit-gate 'denied' payload {\"error\":\"insufficient_credits\",\"balance\":0}.",
        "config": { "content_type": "application/json" },
        "input": [
          { "from": "persist", "lane": "output" },
          { "from": "credit_gate", "lane": "denied" }
        ]
      }
    ]
  }
}
